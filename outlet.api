// Admin Email Validation. A single check waits on DNS and an SMTP probe,
// which the validation service bounds at 20 seconds: its route has the time
// to finish.
@server (
	group:      admin/validation
	prefix:     /api/admin/validation
	middleware: Auth
	timeout:    30s
)
service outlet {
	@handler AdminValidateEmail
	post /check (ValidateEmailRequest) returns (ValidationResult)
}

@server (
	group:      admin/validation
	prefix:     /api/admin/validation
	middleware: Auth
)
service outlet {
	@handler CreateValidationJob
	post /jobs (CreateValidationJobRequest) returns (ValidationJobInfo)

	@handler ListValidationJobs
	get /jobs (ListValidationJobsRequest) returns (ListValidationJobsResponse)

	@handler GetValidationJob
	get /jobs/:id (ValidationJobIdRequest) returns (ValidationJobInfo)

	@handler AppendValidationJobEmails
	post /jobs/:id/emails (AppendValidationJobEmailsRequest) returns (ValidationJobInfo)

	@handler StartValidationJob
	post /jobs/:id/start (ValidationJobIdRequest) returns (ValidationJobInfo)

	@handler CancelValidationJob
	post /jobs/:id/cancel (ValidationJobIdRequest) returns (ValidationJobInfo)

	@handler ListValidationResults
	get /jobs/:id/results (ListValidationResultsRequest) returns (ListValidationResultsResponse)

	@handler ApplyValidationJob
	post /jobs/:id/apply (ApplyValidationJobRequest) returns (ApplyValidationJobResponse)

	@handler GetValidationUsage
	get /usage (ValidationUsageRequest) returns (ValidationUsageResponse)
}

// SDK Email Validation. A single check has the time its probe takes (see
// the admin check).
@server (
	group:      sdk/validation
	prefix:     /sdk/v1/validate
	middleware: APIKeyAuth
	timeout:    30s
)
service outlet {
	@handler ValidateEmail
	post / (ValidateEmailRequest) returns (ValidationResult)
}

// A batch is accepted at once as a validation job; the validation worker
// checks its addresses in the background. Fetch the job and its results with
// its ID until its status is completed.
@server (
	group:      sdk/validation
	prefix:     /sdk/v1/validate
	middleware: APIKeyAuth
)
service outlet {
	@handler ValidateBatch
	post /batch (ValidateBatchRequest) returns (ValidationJobInfo)

	@handler GetValidateBatch
	get /batch/:id (ValidationJobIdRequest) returns (ValidateBatchResponse)
}

// Signal Network hub (only served when SignalNet.Hub is true; 404 otherwise)
@server (
	group:      network
	prefix:     /network/v1
	middleware: NetworkAuth
)
service outlet {
	@handler NetworkLookup
	post /lookup (NetworkLookupRequest) returns (NetworkLookupResponse)

	@handler NetworkReport
	post /report (NetworkReportRequest) returns (NetworkReportResponse)
}

// Outbound: one-to-one outreach for a brand (X-Org-Id). Every route calls the
// same outbound service as the MCP tools.
@server (
	group:      admin/outbound
	prefix:     /api/admin
	middleware: Auth
)
service outlet {
	@handler GetOutboundOverview
	get /outbound returns (OutboundOverview)

	@handler SetOutboundEnabled
	put /outbound/enabled (OutboundEnabledRequest) returns (Response)

	@handler UpdateOutboundSettings
	put /outbound/settings (OutboundSettingsRequest) returns (Response)

	@handler SetOutboundDNSToken
	put /outbound/dns-token (OutboundDNSTokenRequest) returns (Response)

	@handler AddOutboundDomain
	post /outbound/domains (OutboundDomainRequest) returns (OutboundDomainResponse)

	@handler CheckOutboundDomain
	post /outbound/domains/:id/check (OutboundIDRequest) returns (OutboundDomainInfo)

	@handler AddOutboundMailboxes
	post /outbound/mailboxes (OutboundAddMailboxesRequest) returns (OutboundAddMailboxesResponse)

	@handler PauseOutbound
	post /outbound/pause (OutboundPauseRequest) returns (Response)

	@handler ListOutboundProspects
	get /outbound/prospects (OutboundListProspectsRequest) returns (OutboundProspectList)

	@handler AddOutboundProspects
	post /outbound/prospects (OutboundAddProspectsRequest) returns (OutboundAddProspectsResponse)

	@handler MarkOutboundPartner
	post /outbound/prospects/:id/partner (OutboundIDRequest) returns (Response)

	@handler CreateOutboundCampaign
	post /outbound/campaigns (OutboundCampaignRequest) returns (OutboundCampaignResponse)

	@handler GetOutboundCampaign
	get /outbound/campaigns/:id (OutboundIDRequest) returns (OutboundCampaignResults)

	@handler ListOutboundDrafts
	get /outbound/drafts (OutboundListRequest) returns (OutboundDraftList)

	@handler ReviewOutboundDrafts
	post /outbound/drafts/review (OutboundReviewRequest) returns (OutboundReviewResponse)

	@handler EditOutboundDraft
	put /outbound/drafts/:id (OutboundEditDraftRequest) returns (Response)

	@handler ListOutboundReplies
	get /outbound/replies (OutboundListRepliesRequest) returns (OutboundReplyList)

	@handler AnswerOutboundReply
	post /outbound/replies/:id/answer (OutboundAnswerRequest) returns (Response)

	@handler ClassifyOutboundReply
	post /outbound/replies/:id/classify (OutboundClassifyRequest) returns (Response)

	@handler ExplainOutbound
	get /outbound/explain (OutboundExplainRequest) returns (OutboundExplainResponse)

	@handler ListOutboundSegments
	get /outbound/segments returns (OutboundSegmentList)

	@handler CreateOutboundSegment
	post /outbound/segments (OutboundSegmentRequest) returns (OutboundSegment)

	@handler UpdateOutboundSegment
	put /outbound/segments/:id (UpdateOutboundSegmentRequest) returns (OutboundSegment)

	@handler DeleteOutboundSegment
	delete /outbound/segments/:id (OutboundIDRequest) returns (Response)

	@handler AddOutboundSegmentProspects
	post /outbound/segments/:id/prospects (OutboundSegmentAddRequest) returns (OutboundAddProspectsResponse)

	@handler GetOutboundProfile
	get /outbound/profile returns (OutboundProfile)

	@handler UpdateOutboundProfile
	put /outbound/profile (OutboundProfile) returns (OutboundProfile)

	@handler ListOutboundMaterials
	get /outbound/materials (OutboundMaterialListRequest) returns (OutboundMaterialList)

	@handler CreateOutboundMaterial
	post /outbound/materials (OutboundMaterialRequest) returns (OutboundMaterial)

	@handler UpdateOutboundMaterial
	put /outbound/materials/:id (UpdateOutboundMaterialRequest) returns (OutboundMaterial)

	@handler DeleteOutboundMaterial
	delete /outbound/materials/:id (OutboundMaterialIDRequest) returns (Response)

	@handler GetOutboundDoNotContact
	get /outbound/do-not-contact returns (OutboundDNC)

	@handler AddOutboundDoNotContact
	post /outbound/do-not-contact (OutboundDNCAddRequest) returns (OutboundDNCAddResponse)

	@handler DeleteOutboundDoNotContactList
	delete /outbound/do-not-contact (OutboundDNCDeleteRequest) returns (Response)

	@handler CheckOutboundDoNotContact
	get /outbound/do-not-contact/check (OutboundDNCCheckRequest) returns (OutboundDNCCheck)

	@handler UpdateOutboundDoNotContactSettings
	put /outbound/do-not-contact/settings (OutboundDNCSettingsRequest) returns (OutboundDNCSettings)

	@handler GetOutboundPace
	get /outbound/pace returns (OutboundPace)

	@handler SetOutboundPace
	put /outbound/pace (OutboundPaceRequest) returns (OutboundPace)
}

// Sending pathways for a brand (X-Org-Id). Changing them needs the brand's
// admin; the same email service the MCP tools use.
@server (
	group:      admin/sending
	prefix:     /api/admin
	middleware: Auth
)
service outlet {
	@handler ListSendingPathways
	get /sending/pathways returns (SendingPathwayList)

	@handler CreateSendingPathway
	post /sending/pathways (SendingPathwayRequest) returns (SendingPathway)

	@handler UpdateSendingPathway
	put /sending/pathways/:id (UpdateSendingPathwayRequest) returns (SendingPathway)

	@handler DeleteSendingPathway
	delete /sending/pathways/:id (SendingPathwayIDRequest) returns (Response)

	@handler SetMailboxDailyLimit
	put /sending/mailboxes/:id/daily-limit (MailboxDailyLimitRequest) returns (Response)

	@handler MoveSendingDomain
	put /sending/domains/:id/pathway (MoveDomainRequest) returns (Response)
}

// A mailbox pool's connections to mailbox services, for a brand (X-Org-Id):
// the same outbound service as the MCP tools. Adding or removing a
// connection, changing it, moving a domain, connecting a domain, buying,
// syncing and deleting need the brand's admin.
@server (
	group:      admin/outbound
	prefix:     /api/admin
	middleware: Auth
)
service outlet {
	@handler ListMailboxConnections
	get /outbound/connections (MailboxConnectionListRequest) returns (MailboxConnectionList)

	@handler AddMailboxConnection
	post /outbound/connections (MailboxConnectionRequest) returns (MailboxConnection)

	@handler UpdateMailboxConnection
	put /outbound/connections/:id (UpdateMailboxConnectionRequest) returns (MailboxConnection)

	@handler RemoveMailboxConnection
	delete /outbound/connections/:id (MailboxConnectionIDRequest) returns (Response)

	@handler MoveOutboundDomainConnection
	put /outbound/domains/:id/connection (MoveDomainConnectionRequest) returns (MailboxConnection)

	@handler GetMailboxServiceInventory
	get /outbound/connections/:id/inventory (MailboxConnectionIDRequest) returns (MailboxServiceInventory)

	@handler ConnectMailboxServiceDomain
	post /outbound/connections/:id/domains (MailboxServiceConnectRequest) returns (MailboxServiceDomainResponse)

	@handler QuoteMailboxService
	post /outbound/connections/:id/quotes (MailboxServiceQuoteRequest) returns (MailboxServiceQuote)

	@handler BuyMailboxService
	post /outbound/connections/:id/buy (MailboxServiceBuyRequest) returns (MailboxServiceBuyResponse)

	@handler SyncMailboxService
	post /outbound/connections/:id/sync (MailboxServiceSyncRequest) returns (MailboxServiceSyncResponse)

	@handler DeleteMailboxServiceMailbox
	delete /outbound/connections/:id/mailboxes/:mailbox_id (MailboxServiceDeleteRequest) returns (Response)
}

