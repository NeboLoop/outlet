		CheckURL        *string `json:"check_url,optional"` // empty turns the outside check off
		CheckSecret     string  `json:"check_secret,optional"` // write-only; needed with a new check_url
	}
	OutboundPaceEstimate {
		Pace              string `json:"pace"` // light, typical, growth, unlimited or custom
		DailyNewProspects int64  `json:"daily_new_prospects"`
		SendsPerDay       int64  `json:"sends_per_day"` // the most a day once follow-ups catch up
		MailboxesNeeded   int64  `json:"mailboxes_needed"` // at the pool's daily limit per mailbox; 0: either has none
	}
	OutboundPace {
		PoolId            string                 `json:"pool_id"`
		Current           OutboundPaceEstimate   `json:"current"`
		NewToday          int64                  `json:"new_today"`
		StepsPerCampaign  float64                `json:"steps_per_campaign"`
		MailboxDailyLimit int64                  `json:"mailbox_daily_limit"`
		MailboxesActive   int64                  `json:"mailboxes_active"`
		Capacity          int64                  `json:"capacity"` // emails a day the active mailboxes may send now; 0: no limit
		Presets           []OutboundPaceEstimate `json:"presets"`
		Cost              string                 `json:"cost"`
	}
	OutboundPaceRequest {
		Pace              string `json:"pace,optional"` // light, typical, growth or unlimited
		DailyNewProspects *int64 `json:"daily_new_prospects,optional"` // instead of a preset; 0: no limit
	}
	// ========== Sending pathways (per brand) ==========
	// A sending pathway is one configured way a brand delivers mail. Each kind
	// of mail (transactional, marketing, outreach) is carried by one of the
	// brand's pathways. Credentials are write-only.
	SendingLimits {
		DailyLimit      int64   `json:"daily_limit"` // per sender per day; 0: no limit
		WarmupStart     int64   `json:"warmup_start"` // a new sender's first day; 0: no warm-up
		WarmupStep      int64   `json:"warmup_step"` // added each day
		MinGapSeconds   int64   `json:"min_gap_seconds"` // between two sends from one sender
		MaxGapSeconds   int64   `json:"max_gap_seconds"`
		PauseBounceRate float64 `json:"pause_bounce_rate"` // a fraction: 0.03 is 3%, over 7 days
		PauseMinBounces int64   `json:"pause_min_bounces"`
		PauseSpamBlocks int64   `json:"pause_spam_blocks"`
		PauseComplaints int64   `json:"pause_complaints"`
	}
	SendingPathway {
		Id              string                 `json:"id"`
		Name            string                 `json:"name"`
		Provider        string                 `json:"provider"` // platform, ses, smtp, mailboxes
		Kinds           []string               `json:"kinds"` // transactional, marketing, outreach
		AWSRegion       string                 `json:"aws_region,optional"`
		AWSKeysSet      bool                   `json:"aws_keys_set"`
		SMTPHost        string                 `json:"smtp_host,optional"`
		SMTPPort        int64                  `json:"smtp_port,optional"`
		SMTPUsername    string                 `json:"smtp_username,optional"`
		SMTPPasswordSet bool                   `json:"smtp_password_set"`
		Limits          SendingLimits          `json:"limits"`
		Domains         []SendingPathwayDomain `json:"domains"`
		Mailboxes       int64                  `json:"mailboxes"`
		Warning         string                 `json:"warning,optional"` // set when outreach rides a provider other than mailboxes
		CreatedAt       string                 `json:"created_at"`
	}
	SendingPathwayDomain {
		Id      string `json:"id"`
		Domain  string `json:"domain"`
		Purpose string `json:"purpose"` // sending, or outreach (its mailboxes form the pool)
	}
	SendingPathwayList {
		Pathways []SendingPathway `json:"pathways"`
	}
	SendingPathwayRequest {
		Name         string         `json:"name,optional"`
		Provider     string         `json:"provider"` // platform, ses, smtp, mailboxes
		Kinds        []string       `json:"kinds,optional"`
		AWSRegion    string         `json:"aws_region,optional"`
		AWSAccessKey string         `json:"aws_access_key,optional"`
		AWSSecretKey string         `json:"aws_secret_key,optional"`
		SMTPHost     string         `json:"smtp_host,optional"`
		SMTPPort     int64          `json:"smtp_port,optional"`
		SMTPUsername string         `json:"smtp_username,optional"`
		SMTPPassword string         `json:"smtp_password,optional"`
		Limits       *SendingLimits `json:"limits,optional"` // empty: the provider's defaults
	}
	UpdateSendingPathwayRequest {
		Id           string         `path:"id"`
		Name         string         `json:"name,optional"`
		Kinds        []string       `json:"kinds"` // the whole set it carries
		AWSRegion    string         `json:"aws_region,optional"`
		AWSAccessKey string         `json:"aws_access_key,optional"` // empty keeps the stored key
		AWSSecretKey string         `json:"aws_secret_key,optional"`
		SMTPHost     string         `json:"smtp_host,optional"`
		SMTPPort     int64          `json:"smtp_port,optional"`
		SMTPUsername string         `json:"smtp_username,optional"`
		SMTPPassword string         `json:"smtp_password,optional"` // empty keeps the stored password
		Limits       *SendingLimits `json:"limits,optional"` // empty keeps them
	}
	SendingPathwayIDRequest {
		Id string `path:"id"`
	}
	MoveDomainRequest {
		Id        string `path:"id"`
		PathwayId string `json:"pathway_id"` // an outreach domain moves only to a mailbox pool, a sending domain only to platform, ses or smtp
	}
	MailboxDailyLimitRequest {
		Id         string `path:"id"`
		DailyLimit *int64 `json:"daily_limit,optional"` // empty: use the pool's
	}
	// ========== Mailbox connections (per mailbox pool) ==========
	// A mailbox pool holds any number of connections, side by side: manual
	// (domains and mailboxes added by hand) or a mailbox service with its
	// API key, several of one service among them. Each outreach domain
	// belongs to one connection. The API key is write-only. Buying is a
	// quote at a connection, then a buy there with the quote's id and
	// confirm: true; nothing else spends money.
	MailboxConnectionDomain {
		Id     string `json:"id"`
		Domain string `json:"domain"`
	}
	MailboxConnection {
		Id          string                    `json:"id"`
		PoolId      string                    `json:"pool_id"`
		Service     string                    `json:"service"` // manual, maildoso, cheapinboxes, infraforge
		Name        string                    `json:"name"`
		KeySet      bool                      `json:"key_set"`
		DailyLimit  *int64                    `json:"daily_limit,optional"` // its mailboxes' daily limit unless one has its own; empty: the pool's
		WarmupStart *int64                    `json:"warmup_start,optional"` // its mailboxes' warm-up, first day's allowance; empty: the pool's
		WarmupStep  *int64                    `json:"warmup_step,optional"` // added each day until the daily limit; empty: the pool's
		Domains     []MailboxConnectionDomain `json:"domains"`
		Mailboxes   int64                     `json:"mailboxes"`
		CreatedAt   string                    `json:"created_at"`
	}
	MailboxConnectionList {
		Connections []MailboxConnection `json:"connections"`
	}
	MailboxConnectionListRequest {
		PoolId string `form:"pool_id,optional"` // one pool's; empty: every pool's
	}
	MailboxConnectionRequest {
		PoolId      string `json:"pool_id,optional"` // empty: the pool carrying outreach (made if the brand has none)
		Service     string `json:"service"` // manual, maildoso, cheapinboxes, infraforge
		Name        string `json:"name,optional"` // empty: the service's name
		APIKey      string `json:"api_key,optional"` // required for a service; tried before it is saved
		DailyLimit  *int64 `json:"daily_limit,optional"` // the three limits all empty: the service's terms (Maildoso 15 a day, warming up from 5 by 1), else the pool's
		WarmupStart *int64 `json:"warmup_start,optional"`
		WarmupStep  *int64 `json:"warmup_step,optional"`
	}
	UpdateMailboxConnectionRequest {
		Id          string `path:"id"`
		Name        string `json:"name,optional"` // empty keeps it
		APIKey      string `json:"api_key,optional"` // empty keeps the stored key
		DailyLimit  *int64 `json:"daily_limit,optional"` // set as given; empty: the pool's
		WarmupStart *int64 `json:"warmup_start,optional"` // set as given; empty: the pool's
		WarmupStep  *int64 `json:"warmup_step,optional"` // set as given; empty: the pool's
	}
	MailboxConnectionIDRequest {
		Id string `path:"id"` // the connection
	}
	MoveDomainConnectionRequest {
		Id           string `path:"id"` // the outreach domain
		ConnectionId string `json:"connection_id"` // another connection of the domain's pool
	}
	MailboxServiceDomain {
		Id          string   `json:"id"`
		Name        string   `json:"name"`
		Status      string   `json:"status"`
		Nameservers []string `json:"nameservers,optional"`
	}
	MailboxServiceMailbox {
		Id        string `json:"id"`
		Email     string `json:"email"`
		FirstName string `json:"first_name,optional"`
		LastName  string `json:"last_name,optional"`
		Status    string `json:"status"`
		Ready     bool   `json:"ready"`
	}
	MailboxServiceInventory {
		Service   string                  `json:"service"`
		Domains   []MailboxServiceDomain  `json:"domains"`
		Mailboxes []MailboxServiceMailbox `json:"mailboxes"`
	}
	MailboxServiceConnectRequest {
		Id     string `path:"id"` // the connection
		Domain string `json:"domain"`
	}
	MailboxServiceConnection {
		Domain      string   `json:"domain"`
		Nameservers []string `json:"nameservers,optional"` // set these at the domain's registrar
		Status      string   `json:"status,optional"`
		Note        string   `json:"note"`
	}
	MailboxServiceDomainResponse {
		DomainId   string                   `json:"domain_id,optional"`
		Connection MailboxServiceConnection `json:"connection"`
		Check      OutboundDNSCheck         `json:"check"`
	}
	MailboxServicePerson {
		FirstName string `json:"first_name"`
		LastName  string `json:"last_name"`
		Local     string `json:"local,optional"` // before the @; empty: first.last
	}
	MailboxServiceQuoteRequest {
		Id     string                 `path:"id"` // the connection
		Kind   string                 `json:"kind"` // domain, connect, mailboxes
		Domain string                 `json:"domain"`
		People []MailboxServicePerson `json:"people,optional"` // for mailboxes
	}
	MailboxServiceQuote {
		Id         string `json:"id"`
		Service    string `json:"service"`
		Kind       string `json:"kind"`
		Domain     string `json:"domain"`
		Mailboxes  int64  `json:"mailboxes"`
		PriceCents *int64 `json:"price_cents,optional"` // empty: the service's API gives no price
		PriceKnown bool   `json:"price_known"`
		Currency   string `json:"currency,optional"`
		Summary    string `json:"summary"`
		ExpiresAt  string `json:"expires_at"`
	}
	MailboxServiceBuyRequest {
		Id      string `path:"id"` // the connection the quote is from
		QuoteId string `json:"quote_id"`
		Confirm bool   `json:"confirm"` // must be true: buying spends money
	}
	MailboxServiceBuyResponse {
		Summary      string                   `json:"summary"`
		ChargedCents *int64                   `json:"charged_cents,optional"`
		DomainId     string                   `json:"domain_id,optional"`
		Connection   MailboxServiceConnection `json:"connection"`
		Check        *OutboundDNSCheck        `json:"check,optional"`
		Imported     []OutboundMailboxResult  `json:"imported"`
		Pending      []string                 `json:"pending"` // not finished at the service yet; sync with import later
	}
	MailboxServiceSyncRequest {
		Id     string `path:"id"` // the connection
		Import bool   `json:"import,optional"` // import the service's mailboxes the pool lacks
	}
	MailboxServicePoolMailbox {
		Id    string `json:"id"`
		Email string `json:"email"`
	}
	MailboxServiceSyncResponse {
		OnlyAtService []MailboxServiceMailbox     `json:"only_at_service"`
		OnlyInPool    []MailboxServicePoolMailbox `json:"only_in_pool"`
		Imported      []OutboundMailboxResult     `json:"imported"`
		Pending       []string                    `json:"pending"`
	}
	MailboxServiceDeleteRequest {
		Id        string `path:"id"` // the connection
		MailboxId string `path:"mailbox_id"`
	}
)

// ============================================================================
// Service Routes
// ============================================================================
// Health check and setup - public endpoints (no auth)
@server (
	group:  public
	prefix: /api/v1
)
service outlet {
	@handler Health
	get /health returns (HealthResponse)

	@doc "Check if initial setup is required"
	@handler GetPublicSetupStatus
	get /setup/status returns (SetupStatusResponse)

	@doc "Create initial admin account (only works when no admin exists)"
	@handler CreateInitialAdmin
	post /setup/admin (CreateInitialAdminRequest) returns (CreateInitialAdminResponse)
}

// NOTE: There is also a GET /api/v1/admin/setup-status endpoint below that requires auth
// The public /setup/status endpoint above is for initial setup flow before any admin exists
// Note: Email verification and tracking endpoints are registered manually in outlet.go
// because they need custom response handling (redirects, pixels)
// - GET /api/confirm-email - double opt-in confirmation (redirects)
// - GET /api/e/o/:token - email open tracking (returns 1x1 pixel)
// - GET /api/e/c/:token - email click tracking (redirects)
// ============================================================================
// API Service
// ============================================================================
// ----------------------------------------------------------------------------
// Public Endpoints (No Authentication Required)
// ----------------------------------------------------------------------------
// Auth endpoints (rate limited to prevent brute force attacks)
@server (
	prefix:     /api/v1
	group:      auth
	middleware: AuthRateLimit
)
service outlet {
	@doc "User login"
	@handler login
	post /auth/login (LoginRequest) returns (LoginResponse)

	@doc "Create an account from an invitation (Outlet is invite-only)"
	@handler register
	post /auth/register (RegisterRequest) returns (RegisterResponse)

	@doc "Email a sign-in link and code (the same answer whether or not the address has an account)"
	@handler sendSignInEmail
	post /auth/sign-in-email (SendSignInEmailRequest) returns (SendSignInEmailResponse)

	@doc "Sign in with the emailed link's token, or with the email and its code"
	@handler signInWithEmail
	post /auth/sign-in-email/verify (SignInWithEmailRequest) returns (LoginResponse)

	@doc "Request password reset"
	@handler forgotPassword
	post /auth/forgot-password (ForgotPasswordRequest) returns (ForgotPasswordResponse)

	@doc "Reset password with token"
	@handler resetPassword
	post /auth/reset-password (ResetPasswordRequest) returns (ResetPasswordResponse)

	@doc "Verify email address"
	@handler verifyEmail
	get /auth/verify-email (VerifyEmailRequest) returns (VerifyEmailResponse)

	@doc "Validate invitation token and get user details"
	@handler validateInvitation
	get /auth/validate-invitation (ValidateInvitationRequest) returns (ValidateInvitationResponse)

	@doc "Refresh access token using refresh token"
	@handler refreshToken
	post /auth/refresh (RefreshTokenRequest) returns (LoginResponse)
}

// ============================================================================
// Admin Endpoints (Protected - Token Required)
// ============================================================================
// Admin Auth
@server (
	group:      admin/auth
	prefix:     /api/admin
	middleware: Auth
)
service outlet {
	@handler Logout
	post /auth/logout returns (AnalyticsResponse)

	@handler GetCurrentUser
	get /auth/me returns (UserInfo)

	@doc "Accept an invitation to a brand as the signed-in person (the invitation's email must be theirs)"
	@handler AcceptInvitation
	post /auth/accept-invitation (AcceptInvitationRequest) returns (Response)
}

// Admin Webhooks
@server (
	group:      admin/webhooks
	prefix:     /api/admin/webhooks
	middleware: Auth
)
service outlet {
	@handler AdminListWebhooks
	get / returns (ListWebhooksResponse)

	@handler AdminCreateWebhook
	post / (RegisterWebhookRequest) returns (RegisterWebhookResponse)

	@handler AdminGetWebhook
	get /:id (GetWebhookRequest) returns (WebhookInfo)

	@handler AdminUpdateWebhook
	put /:id (UpdateWebhookRequest) returns (WebhookInfo)

	@handler AdminDeleteWebhook
	delete /:id (DeleteWebhookRequest) returns (Response)

	@handler AdminTestWebhook
	post /:id/test (TestWebhookRequest) returns (TestWebhookResponse)

	@handler AdminListWebhookLogs
	get /:id/logs (ListWebhookLogsRequest) returns (ListWebhookLogsResponse)

	@doc "A webhook's deliveries, newest first: status, tries and next retry"
	@handler AdminListWebhookDeliveries
	get /:id/deliveries (ListWebhookDeliveriesRequest) returns (ListWebhookDeliveriesResponse)

	@doc "Send a delivery again now, signed the same way"
	@handler AdminResendWebhookDelivery
	post /:id/deliveries/:delivery_id/resend (ResendWebhookDeliveryRequest) returns (ResendWebhookDeliveryResponse)
}

// Admin Users
@server (
	group:      admin/users
	prefix:     /api/admin
	middleware: Auth
)
service outlet {
	@handler ListUsers
	get /users returns (UserListResponse)

	@handler GetUser
	get /users/:id (GetUserRequest) returns (UserInfo)

	@handler CreateUser
	post /users (CreateUserRequest) returns (CreateUserResponse)

	@handler UpdateUser
	put /users/:id (UpdateUserRequest) returns (UserInfo)

	@handler DeleteUser
	delete /users/:id (DeleteUserRequest) returns (Response)
}

// MCP API Keys (User Settings)
@server (
	group:      admin/apikeys
	prefix:     /api/admin
	middleware: Auth
)
service outlet {
	@handler ListMCPAPIKeys
	get /api-keys returns (ListMCPAPIKeysResponse)

	@handler CreateMCPAPIKey
	post /api-keys (CreateMCPAPIKeyRequest) returns (CreateMCPAPIKeyResponse)

	@handler RevokeMCPAPIKey
	delete /api-keys/:id (RevokeMCPAPIKeyRequest) returns (RevokeMCPAPIKeyResponse)
}

// Admin Subscribers
@server (
	group:      admin/subscribers
	prefix:     /api/admin
	middleware: Auth
)
service outlet {
	@handler VerifySubscriber
	post /subscribers/:id/verify (SubscriberActionRequest) returns (SubscriberInfo)

	@handler UnsubscribeSubscriber
	post /subscribers/:id/unsubscribe (SubscriberActionRequest) returns (SubscriberInfo)

	@handler ResubscribeSubscriber
	post /subscribers/:id/resubscribe (SubscriberActionRequest) returns (SubscriberInfo)

	@handler BlockSubscriber
	post /subscribers/:id/block (SubscriberActionRequest) returns (SubscriberInfo)

	@handler UnblockSubscriber
	post /subscribers/:id/unblock (SubscriberActionRequest) returns (SubscriberInfo)
}

// Admin Lists
@server (
	group:      admin/lists
	prefix:     /api/admin
	middleware: Auth
)
service outlet {
	@handler ListLists
	get /lists returns (ListListsResponse)

	@handler GetList
	get /lists/:id (GetListRequest) returns (ListInfo)

	@handler CreateList
	post /lists (CreateListRequest) returns (ListInfo)

	@handler UpdateList
	put /lists/:id (UpdateListRequest) returns (ListInfo)

	@handler DeleteList
	delete /lists/:id (DeleteListRequest) returns (Response)

	@handler GetListStats
	get /lists/:id/stats (GetListRequest) returns (ListStatsResponse)

	@handler ListListSubscribers
	get /lists/:id/subscribers (ListSubscribersRequest) returns (ListSubscribersResponse)

	@handler AddListSubscriber
	post /lists/:id/subscribers (AddListSubscriberRequest) returns (Response)

	@handler RemoveListSubscriber
	delete /lists/:id/subscribers/:subscriberId (RemoveSubscriberRequest) returns (Response)

	@handler GetSubscriberDetail
	get /lists/:id/subscribers/:subscriberId (GetSubscriberDetailRequest) returns (SubscriberDetailResponse)

	@handler GetEmailDashboardStats
	get /email-stats (EmailDashboardStatsRequest) returns (EmailDashboardStatsResponse)

	@handler GetListEmbedCode
	get /lists/:id/embed-code (GetEmbedCodeRequest) returns (EmbedCodeResponse)

	// Custom Fields
	@handler ListCustomFields
	get /lists/:listId/custom-fields (ListCustomFieldsRequest) returns (ListCustomFieldsResponse)

	@handler GetCustomField
	get /lists/:listId/custom-fields/:fieldId (GetCustomFieldRequest) returns (CustomFieldInfo)

	@handler CreateCustomField
	post /lists/:listId/custom-fields (CreateCustomFieldRequest) returns (CustomFieldInfo)

	@handler UpdateCustomField
	put /lists/:listId/custom-fields/:fieldId (UpdateCustomFieldRequest) returns (CustomFieldInfo)

	@handler DeleteCustomField
	delete /lists/:listId/custom-fields/:fieldId (DeleteCustomFieldRequest) returns (Response)
}

// Admin Blocklist Management (Blocked Domains + Suppression)
@server (
	group:      admin/blocklist
	prefix:     /api/admin
	middleware: Auth
)
service outlet {
	// Blocked Domains
	@handler ListBlockedDomains
	get /blocked-domains (ListBlockedDomainsRequest) returns (ListBlockedDomainsResponse)

	@handler CreateBlockedDomain
	post /blocked-domains (CreateBlockedDomainRequest) returns (BlockedDomainInfo)

	@handler DeleteBlockedDomain
	delete /blocked-domains/:id (DeleteBlockedDomainRequest) returns (Response)

	@handler BulkBlockDomains
	post /blocked-domains/bulk (BulkBlockDomainsRequest) returns (BulkBlockDomainsResponse)

	// Suppression List
	@handler ListSuppressedEmails
	get /suppression-list (ListSuppressedEmailsRequest) returns (ListSuppressedEmailsResponse)

	@handler AddSuppressedEmail
	post /suppression-list (AddSuppressedEmailRequest) returns (SuppressedEmailInfo)

	@handler DeleteSuppressedEmail
	delete /suppression-list/:id (DeleteSuppressedEmailRequest) returns (Response)

	@handler BulkSuppressEmails
	post /suppression-list/bulk (BulkSuppressEmailsRequest) returns (BulkSuppressEmailsResponse)

	@handler ClearSuppressionList
	delete /suppression-list returns (Response)
}

