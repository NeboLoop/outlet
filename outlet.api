	}
	GetEmailStatsRequest {
		StartDate string `form:"start_date,optional"` // RFC3339
		EndDate   string `form:"end_date,optional"` // RFC3339
		GroupBy   string `form:"group_by,optional"` // day, week, month
	}
	EmailStatsPoint {
		Date      string  `json:"date"`
		Sent      int     `json:"sent"`
