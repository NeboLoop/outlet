		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@types/eslint": "^9.6.1",
		"@types/js-yaml": "^4.0.9",
		"@types/turndown": "^5.0.6",
		"@vitest/browser-playwright": "^5.0.2",
		"daisyui": "^5.7.46",
